<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Blog Media</title>

    <!-- Bootstrap / Bootswatch CSS -->
    <link rel="stylesheet" href="~/lib/bootswatch/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Site CSS & Scoped CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BlogMedia.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <header>
        <partial name="_Navbar" />
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="mt-4 pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-white" style="background: linear-gradient(135deg, #1a252f, #2c3e50); border-top: none !important; box-shadow: 0 -4px 20px rgba(0,0,0,0.3); padding: 2rem 0 1.5rem 0; margin-top: auto;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-12 text-center">
                    <h5 style="color: #ecf0f1; font-weight: 700; letter-spacing: 0.5px; margin-bottom: 0.3rem;">
                        <span style="color: #3498db;">Trex</span> Development
                    </h5>
                </div>
            </div>
            <hr style="border-color: rgba(255,255,255,0.08); margin: 1.2rem 0 0.8rem 0;">
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>